---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/static.css';

interface Props {
	title: string;
	description: string;
	/** Name of an icon from src/utils/icons.ts */
	icon?: string;
	/** Short sentence shown under the title in the hero */
	lead?: string;
	/** Hero gradient colours (also used as page accent colours) */
	c1?: string;
	c2?: string;
	/** Shown as a small "Last updated" pill in the hero */
	updated?: string;
	/** Wider content column (About page) */
	wide?: boolean;
}

const {
	title,
	description,
	icon = 'luggage',
	lead,
	c1 = '#0f2f45',
	c2 = '#3b7f8f',
	updated,
	wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Baggage Gear`} description={description} />
	</head>
	<body>
		<Header />
		<section class="sp-hero" style={`--pc1:${c1};--pc2:${c2}`}>
			<div class={`sp-hero-inner${wide ? '' : ' narrow'}`}>
				<nav class="sp-crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><span>{title}</span>
				</nav>
				<slot name="hero">
					<div class="sp-hero-chip"><Icon name={icon} size={30} /></div>
					<h1 class="sp-hero-title">{title}</h1>
					{lead && <p class="sp-hero-lead">{lead}</p>}
					{updated && (
						<span class="sp-updated"><Icon name="clock" size={15} /> Last updated {updated}</span>
					)}
				</slot>
			</div>
		</section>
		<main class={`sp-main${wide ? ' wide' : ''}`} style={`--pc1:${c1};--pc2:${c2}`}>
			<div class="static-page">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
