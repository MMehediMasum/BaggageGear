---
import { slugify } from '../../utils/slug';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
	return categories.map((category) => ({
		params: { category: slugify(category) },
		props: { categoryName: category },
	}));
}

const { categoryName } = Astro.props;
const allPosts = await getCollection('blog');
const postsInCategory = allPosts
	.filter((post) => post.data.categories.includes(categoryName))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featuredPost, ...restPosts] = postsInCategory;

// Parent topic = the topic most posts in this category belong to (used for the breadcrumb)
const topicCounts = new Map<string, number>();
for (const post of postsInCategory) {
	if (post.data.topic) {
		topicCounts.set(post.data.topic, (topicCounts.get(post.data.topic) ?? 0) + 1);
	}
}
const parentTopic = [...topicCounts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 100% - 2.5em);
				max-width: none;
				padding: 2.2em 0 4em;
			}
			.breadcrumb {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5em;
				margin: 0 0 1.6rem;
				font-size: 0.88rem;
				color: rgb(var(--gray));
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.breadcrumb .sep {
				opacity: 0.5;
			}
			.category-header {
				margin-bottom: 2.4rem;
				padding-bottom: 1.8rem;
				border-bottom: 1px solid var(--line);
			}
			.category-title {
				max-width: 20em;
				margin: 0 0 0.4rem;
			}
			.category-meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem 1.6rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-grid li {
				margin: 0;
				min-width: 0;
			}
			.card {
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				color: rgb(var(--black));
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
				color: rgb(var(--black));
			}
			.thumb {
				position: relative;
				aspect-ratio: 16 / 10;
				overflow: hidden;
				background: linear-gradient(135deg, var(--accent-soft), rgba(var(--gray-light), 0.9));
			}
			.thumb img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.4s ease;
			}
			.card:hover .thumb img {
				transform: scale(1.04);
			}
			.thumb-fallback {
				display: grid;
				place-items: center;
				height: 100%;
				color: var(--accent);
				opacity: 0.6;
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				gap: 0.5rem;
				padding: 1.1rem 1.2rem 1.25rem;
			}
			.title {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.card:hover .title {
				color: var(--accent);
			}
			.date {
				margin: auto 0 0;
				padding-top: 0.3rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-weight: 500;
			}

			/* Featured (latest) post: wide, two-column card */
			.post-grid li.featured {
				grid-column: 1 / -1;
			}
			.featured .card {
				flex-direction: row;
			}
			.featured .thumb {
				flex: 1 1 56%;
				aspect-ratio: auto;
				min-height: 320px;
			}
			.featured .card-body {
				flex: 1 1 44%;
				justify-content: center;
				gap: 0.8rem;
				padding: 2rem 2.2rem;
			}
			.featured .badge {
				align-self: flex-start;
				padding: 0.25em 0.8em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}
			.featured .title {
				font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.1rem);
				line-height: 1.2;
			}
			.featured .date {
				margin-top: 0;
				font-size: 0.92rem;
			}
			.empty {
				padding: 3rem 1rem;
				text-align: center;
				color: rgb(var(--gray));
			}
			@media (max-width: 960px) {
				.post-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 720px) {
				main {
					padding-top: 1.2em;
				}
				.featured .card {
					flex-direction: column;
				}
				.featured .thumb {
					flex: none;
					min-height: 0;
					aspect-ratio: 16 / 10;
				}
				.featured .card-body {
					padding: 1.2rem 1.25rem 1.4rem;
				}
			}
			@media (max-width: 600px) {
				.post-grid {
					grid-template-columns: 1fr;
					gap: 1.3rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.card,
				.thumb img {
					transition: none;
				}
				.card:hover,
				.card:hover .thumb img {
					transform: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				{
					parentTopic && (
						<>
							<span class="sep" aria-hidden="true">/</span>
							<a href={`/topic/${slugify(parentTopic)}/`}>{parentTopic}</a>
						</>
					)
				}
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current="page">{categoryName}</span>
			</nav>

			<header class="category-header">
				<span class="eyebrow">Category</span>
				<h1 class="category-title">{categoryName}</h1>
				<p class="category-meta">
					{postsInCategory.length} {postsInCategory.length === 1 ? 'article' : 'articles'}
				</p>
			</header>

			<section>
				{
					postsInCategory.length === 0 ? (
						<p class="empty">No posts found in this category yet.</p>
					) : (
						<ul class="post-grid">
							<li class="featured">
								<a class="card" href={`/${featuredPost.id}/`}>
									<div class="thumb">
										{featuredPost.data.heroImage ? (
											<img width="960" height="600" src={featuredPost.data.heroImage} alt="" loading="eager" />
										) : (
											<div class="thumb-fallback">
												<Icon name="luggage" size={56} />
											</div>
										)}
									</div>
									<div class="card-body">
										<span class="badge">Latest</span>
										<h2 class="title">{featuredPost.data.title}</h2>
										<p class="date">
											<FormattedDate date={featuredPost.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
							{restPosts.map((post) => (
								<li>
									<a class="card" href={`/${post.id}/`}>
										<div class="thumb">
											{post.data.heroImage ? (
												<img width="480" height="300" src={post.data.heroImage} alt="" loading="lazy" />
											) : (
												<div class="thumb-fallback">
													<Icon name="luggage" size={40} />
												</div>
											)}
										</div>
										<div class="card-body">
											<h2 class="title">{post.data.title}</h2>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
