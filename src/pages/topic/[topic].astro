---
import { slugify } from '../../utils/slug';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const topics = [...new Set(allPosts.map((post) => post.data.topic).filter(Boolean))];
	return topics.map((topic) => ({
		params: { topic: slugify(topic) },
		props: { topicName: topic },
	}));
}

const { topicName } = Astro.props;
const allPosts = await getCollection('blog');
const postsInTopic = allPosts.filter((post) => post.data.topic === topicName);

const categoryCounts = new Map();
for (const post of postsInTopic) {
	for (const category of post.data.categories ?? []) {
		categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
	}
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

function thumbUrl(category: string) {
	const q = encodeURIComponent(`${topicName} ${category}`);
	return `https://tse1.mm.bing.net/th?q=${q}&w=474&h=274&c=7`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${topicName} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 100% - 2.5em);
				max-width: none;
				padding: 2.2em 0 4em;
			}
			.breadcrumb {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5em;
				margin: 0 0 1.6rem;
				font-size: 0.88rem;
				color: rgb(var(--gray));
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.breadcrumb .sep {
				opacity: 0.5;
			}
			.topic-header {
				margin-bottom: 2.4rem;
				padding-bottom: 1.8rem;
				border-bottom: 1px solid var(--line);
			}
			.topic-title {
				max-width: 20em;
				margin: 0 0 0.6rem;
			}
			.topic-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 0;
			}
			.topic-meta span {
				padding: 0.3em 0.9em;
				border-radius: 999px;
				background: var(--surface);
				border: 1px solid var(--line);
				color: rgb(var(--gray-dark));
				font-size: 0.88rem;
				font-weight: 600;
			}
			.category-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
				gap: 1.6rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.category-grid li {
				margin: 0;
			}
			.category-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				text-decoration: none;
				color: rgb(var(--black));
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.category-card:hover {
				transform: translateY(-4px);
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
				color: rgb(var(--black));
			}
			.thumb {
				position: relative;
				width: 100%;
				aspect-ratio: 474 / 274;
				overflow: hidden;
				background: linear-gradient(135deg, var(--accent-soft), rgba(var(--gray-light), 0.9));
			}
			.thumb img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.4s ease;
			}
			.category-card:hover .thumb img {
				transform: scale(1.05);
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				padding: 1rem 1.2rem 1.15rem;
			}
			.cat-name {
				margin: 0;
				font-size: 1.12rem;
				line-height: 1.3;
				min-height: calc(1.3em * 2);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				transition: color 0.2s ease;
			}
			.card-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-top: auto;
				padding-top: 0.7rem;
				color: rgb(var(--gray));
				font-size: 0.86rem;
				font-weight: 500;
			}
			.arrow {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				border-radius: 50%;
				background: var(--accent-soft);
				color: var(--accent);
				transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
			}
			.category-card:hover .cat-name {
				color: var(--accent);
			}
			.category-card:hover .arrow {
				transform: translateX(3px);
				background: var(--accent);
				color: var(--on-accent);
			}
			.empty {
				padding: 3rem 1rem;
				text-align: center;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				main {
					padding-top: 1.2em;
				}
			}
			@media (max-width: 480px) {
				.category-grid {
					grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
					gap: 1rem;
				}
				.card-body {
					padding: 0.85rem 0.95rem 1rem;
				}
				.cat-name {
					font-size: 1rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.category-card,
				.thumb img,
				.arrow {
					transition: none;
				}
				.category-card:hover,
				.category-card:hover .thumb img,
				.category-card:hover .arrow {
					transform: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current="page">{topicName}</span>
			</nav>

			<header class="topic-header">
				<span class="eyebrow">Topic</span>
				<h1 class="topic-title">{topicName}</h1>
				<p class="topic-meta">
					<span>{categories.length} {categories.length === 1 ? 'category' : 'categories'}</span>
					<span>{postsInTopic.length} {postsInTopic.length === 1 ? 'article' : 'articles'}</span>
				</p>
			</header>

			<section>
				{
					categories.length === 0 ? (
						<p class="empty">No categories found under this topic yet.</p>
					) : (
						<ul class="category-grid">
							{categories.map(([category, count]) => (
								<li>
									<a class="category-card" href={`/categories/${slugify(category)}/`}>
										<div class="thumb">
											<img
												src={thumbUrl(category)}
												alt=""
												loading="lazy"
												onerror="this.style.display='none'"
											/>
										</div>
										<div class="card-body">
											<h2 class="cat-name">{category}</h2>
											<div class="card-foot">
												<span>
													{count} {count === 1 ? 'article' : 'articles'}
												</span>
												<span class="arrow" aria-hidden="true">
													<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
														<path d="M3 8h10M9 4l4 4-4 4" />
													</svg>
												</span>
											</div>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
