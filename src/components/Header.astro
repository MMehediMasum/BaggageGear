---
import { slugify } from '../utils/slug';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const posts = await getCollection('blog');
const topics = [...new Set(posts.map((post) => post.data.topic).filter(Boolean))].sort();
---

<header class="site-header">
	<nav class="nav" aria-label="Main">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} — home`}>
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
					<rect x="4" y="7" width="16" height="13" rx="2.5"></rect>
					<path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"></path>
					<path d="M9 11v5M15 11v5"></path>
				</svg>
			</span>
			<span class="brand-text">Baggage<span class="brand-accent">Gear</span></span>
		</a>

		<div class="internal-links" id="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="dropdown">
				<button
					id="categories-trigger"
					class="dropdown-trigger"
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
					aria-controls="categories-menu"
				>
					Topics
					<svg class="chev" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
						<path d="M2 4.2 6 8l4-3.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
				<ul id="categories-menu" class="dropdown-menu">
					{
						topics.map((topic) => (
							<li>
								<a href={`/topic/${slugify(topic)}/`}>
									{topic}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="header-actions">
			<button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" type="button">
				<svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 14.2A8 8 0 0 1 9.8 4a8 8 0 1 0 10.2 10.2Z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
			</button>
			<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<script>
	const themeButton = document.getElementById('theme-toggle');

	themeButton?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
	});

	const catTrigger = document.getElementById('categories-trigger');
	const catMenu = document.getElementById('categories-menu');

	function closeTopics() {
		catMenu?.classList.remove('open');
		catTrigger?.setAttribute('aria-expanded', 'false');
	}

	catTrigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = catMenu?.classList.toggle('open');
		catTrigger.setAttribute('aria-expanded', String(!!isOpen));
	});

	document.addEventListener('click', closeTopics);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeTopics();
	});

	const mobileToggle = document.getElementById('mobile-menu-toggle');
	const internalLinks = document.getElementById('internal-links');

	mobileToggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = internalLinks?.classList.toggle('mobile-open');
		mobileToggle.setAttribute('aria-expanded', String(!!isOpen));
		mobileToggle.classList.toggle('active', !!isOpen);
	});

	internalLinks?.addEventListener('click', (e) => {
		const target = e.target;
		if (target instanceof HTMLElement && target.tagName === 'A') {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});

	document.addEventListener('click', (e) => {
		if (
			internalLinks?.classList.contains('mobile-open') &&
			!internalLinks.contains(e.target as Node) &&
			e.target !== mobileToggle
		) {
			internalLinks.classList.remove('mobile-open');
			mobileToggle?.setAttribute('aria-expanded', 'false');
			mobileToggle?.classList.remove('active');
		}
	});
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.25em;
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		-webkit-backdrop-filter: saturate(160%) blur(12px);
		backdrop-filter: saturate(160%) blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 1.5em;
		max-width: 1100px;
		min-height: 68px;
		margin: 0 auto;
	}

	/* Brand */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		margin-right: auto;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand:hover {
		color: rgb(var(--black));
	}
	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 11px;
		background: var(--accent);
		color: var(--on-accent);
		box-shadow: 0 4px 10px rgba(180, 68, 14, 0.28);
		transition: transform 0.2s ease;
	}
	.brand:hover .brand-mark {
		transform: rotate(-6deg);
	}
	.brand-text {
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.brand-accent {
		color: var(--accent);
	}

	/* Links */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.3em;
	}
	.internal-links > :global(a),
	.dropdown-trigger {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.55em 0.9em;
		border: none;
		border-radius: 999px;
		background: none;
		color: rgb(var(--black));
		font-family: var(--font-sans);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		opacity: 0.78;
		transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}
	.internal-links > :global(a:hover),
	.dropdown-trigger:hover,
	.dropdown-trigger[aria-expanded='true'] {
		opacity: 1;
		background: var(--accent-soft);
		color: rgb(var(--black));
	}
	.internal-links > :global(a.active) {
		opacity: 1;
		color: var(--accent);
		background: var(--accent-soft);
	}
	.chev {
		transition: transform 0.2s ease;
	}
	.dropdown-trigger[aria-expanded='true'] .chev {
		transform: rotate(180deg);
	}

	/* Dropdown */
	.dropdown {
		position: relative;
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		min-width: 300px;
		width: max-content;
		max-width: 92vw;
		margin: 0;
		padding: 0.5em;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 14px;
		box-shadow: var(--box-shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		z-index: 60;
	}
	.dropdown-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown-menu li {
		margin: 0;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 0.9em;
		border-radius: 9px;
		color: rgb(var(--black));
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.35;
		text-decoration: none;
	}
	.dropdown-menu a:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}

	/* Actions */
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.3em;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: rgb(var(--black));
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.theme-toggle .icon-sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .icon-sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .theme-toggle .icon-moon {
		display: none;
	}

	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 4px;
		width: 40px;
		height: 40px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: rgb(var(--black));
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	@media (max-width: 720px) {
		.nav {
			flex-wrap: wrap;
			gap: 0;
			min-height: 62px;
		}
		.brand-text {
			font-size: 1.25rem;
		}
		.header-actions {
			gap: 0.4em;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
			order: 3;
			padding: 0.4em 0 1em;
			border-top: 1px solid var(--line);
		}
		.internal-links.mobile-open {
			display: flex;
		}
		.internal-links > :global(a),
		.dropdown-trigger {
			width: 100%;
			justify-content: space-between;
			padding: 0.8em 0.4em;
			border-radius: 8px;
			text-align: left;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-menu {
			position: static;
			min-width: 0;
			width: auto;
			max-width: none;
			border: none;
			box-shadow: none;
			background: transparent;
			opacity: 1;
			visibility: visible;
			transform: none;
			display: none;
			padding: 0 0 0 0.6em;
		}
		.dropdown-menu.open {
			display: block;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.chev,
		.dropdown-menu {
			transition: none;
		}
	}
</style>
