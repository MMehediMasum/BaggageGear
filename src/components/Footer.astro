---
import { SITE_TITLE } from '../consts';
import Icon from './Icon.astro';

const today = new Date();

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const footerLinks = [
	{ href: '/about/', label: 'About Us', icon: 'user' },
	{ href: '/contact/', label: 'Contact', icon: 'mail' },
	{ href: '/privacy-policy/', label: 'Privacy Policy', icon: 'lock' },
	{ href: '/disclosure/', label: 'Disclosure', icon: 'coins' },
	{ href: '/terms/', label: 'Terms', icon: 'scroll' },
].filter((link) => normalize(link.href) !== normalize(Astro.url.pathname));
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="footer-brand">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<rect x="4" y="7" width="16" height="13" rx="2.5"></rect>
							<path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"></path>
							<path d="M9 11v5M15 11v5"></path>
						</svg>
					</span>
					<span class="brand-text">Baggage<span class="brand-accent">Gear</span></span>
				</a>
				<p class="tagline">
					Airline baggage rules, honest luggage reviews and smart packing advice, so you can
					travel lighter and calmer.
				</p>
				<div class="social-links">
					<a
						href="https://www.facebook.com/IverCalloway/"
						target="_blank"
						rel="nofollow noopener noreferrer"
					>
						<span class="sr-only">Follow Baggage Gear on Facebook</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
							<path
								fill="currentColor"
								d="M9.25 16V8.703h2.45l.367-2.845H9.25V4.04c0-.824.229-1.386 1.411-1.386h1.508V.11A20.21 20.21 0 0 0 9.97 0C7.795 0 6.305 1.327 6.305 3.764v2.094H3.846v2.845h2.459V16h2.945z"
							></path>
						</svg>
					</a>
				</div>
			</div>

			<nav class="footer-col" aria-label="Footer">
				<h2 class="col-title">{SITE_TITLE}</h2>
				<ul class="company-links">
					{
						footerLinks.map((link) => (
							<li>
								<a href={link.href}>
									<Icon name={link.icon} size={15} />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="affiliate-note">
				Baggage Gear is a participant in the Amazon Services LLC Associates Program. As an Amazon
				Associate, we earn from qualifying purchases. <a href="/disclosure/">Learn more</a>.
			</p>
			<p class="copy">&copy; {today.getFullYear()} Baggage Gear. All rights reserved.</p>
		</div>
	</div>
</footer>
<style>
	.site-footer {
		--f-bg: #0f1624;
		--f-text: #aab4c6;
		--f-head: #ffffff;
		--f-line: rgba(255, 255, 255, 0.1);
		--f-accent: #f59a58;
		margin-top: 2em;
		padding: 3.5em 1.25em 4em;
		background: var(--f-bg);
		color: var(--f-text);
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 2.5em 3em;
	}

	/* Brand column */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		color: var(--f-head);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--f-head);
	}
	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: #c2501a;
		color: #fff;
	}
	.brand-text {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.brand-accent {
		color: var(--f-accent);
	}
	.tagline {
		max-width: 26em;
		margin: 1em 0 1.2em;
	}
	.social-links {
		display: flex;
		gap: 0.6em;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--f-line);
		border-radius: 50%;
		color: var(--f-text);
		transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}
	.social-links a:hover {
		color: #fff;
		border-color: var(--f-accent);
		background: rgba(245, 154, 88, 0.14);
	}

	/* Link columns */
	.col-title {
		margin: 0 0 1em;
		color: var(--f-head);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55em;
	}
	.footer-col a {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		color: var(--f-text);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-col a:hover {
		color: var(--f-accent);
	}
	.footer-col a :global(svg) {
		flex: none;
		opacity: 0.75;
	}

	/* Bottom bar */
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1em 2em;
		margin-top: 3em;
		padding-top: 1.6em;
		border-top: 1px solid var(--f-line);
		font-size: 0.85rem;
	}
	.footer-bottom p {
		margin: 0;
	}
	.affiliate-note {
		max-width: 46em;
		line-height: 1.55;
	}
	.affiliate-note a {
		color: var(--f-head);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.affiliate-note a:hover {
		color: var(--f-accent);
	}
	.copy {
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.site-footer {
			padding-top: 2.6em;
		}
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.copy {
			white-space: normal;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.social-links a,
		.footer-col a {
			transition: none;
		}
	}
</style>
